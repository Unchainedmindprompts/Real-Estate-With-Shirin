{
  "name": "nextapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/audit-schema-ids.mjs",
    "audit:schema": "node scripts/audit-schema-ids.mjs",
    "typecheck": "tsc --noEmit",
    "validate:source": "node scripts/validate-source-assets.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "check": "npm run typecheck && npm run lint && npm run validate:source",
    "verify:build": "npm run validate:routes && npm run validate:links",
    "verify": "npm run check && npm run build && npm run verify:build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
